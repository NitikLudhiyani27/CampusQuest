# API
PORT=3000

# PostgreSQL
# Use DB_HOST=postgres when running inside Docker Compose.
# Use DB_HOST=localhost when running the API directly on your machine.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=campusquest
DB_USER=campus
DB_PASSWORD=campus123

# Firebase Admin (from your service account JSON)
# Keep the private key on ONE line, wrapped in double quotes, with literal \n for line breaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"
